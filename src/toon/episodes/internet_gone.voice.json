{
  "engine": "gtts",
  "voice": "ru",
  "total_duration": 211.674,
  "lines": [
    {
      "text": "А что, если интернет пропадёт навсегда?",
      "start": 0.45,
      "end": 4.122,
      "duration": 3.672
    },
    {
      "text": "Завтра утром ты просыпаешься.",
      "start": 4.422,
      "end": 6.966,
      "duration": 2.544
    },
    {
      "text": "Хочешь проверить погоду.",
      "start": 7.266,
      "end": 9.354,
      "duration": 2.088
    },
    {
      "text": "Телефон не грузит.",
      "start": 9.654,
      "end": 11.358,
      "duration": 1.704
    },
    {
      "text": "Вай-фай есть, но интернета нет.",
      "start": 11.658,
      "end": 14.73,
      "duration": 3.072
    },
    {
      "text": "Перезагрузил роутер.",
      "start": 15.03,
      "end": 16.878,
      "duration": 1.848
    },
    {
      "text": "Всё равно ничего.",
      "start": 17.178,
      "end": 18.786,
      "duration": 1.608
    },
    {
      "text": "Открыл новости.",
      "start": 19.086,
      "end": 20.646,
      "duration": 1.56
    },
    {
      "text": "Пусто.",
      "start": 20.946,
      "end": 21.906,
      "duration": 0.96
    },
    {
      "text": "Проверил соцсети.",
      "start": 22.206,
      "end": 23.958,
      "duration": 1.752
    },
    {
      "text": "Тоже пусто.",
      "start": 24.258,
      "end": 25.506,
      "duration": 1.248
    },
    {
      "text": "Что происходит?",
      "start": 25.806,
      "end": 27.414,
      "duration": 1.608
    },
    {
      "text": "Представь: весь интернет исчез.",
      "start": 27.714,
      "end": 30.666,
      "duration": 2.952
    },
    {
      "text": "Разом. Везде. Навсегда.",
      "start": 30.966,
      "end": 33.798,
      "duration": 2.832
    },
    {
      "text": "День первый.",
      "start": 34.098,
      "end": 35.418,
      "duration": 1.32
    },
    {
      "text": "Никакой связи.",
      "start": 35.718,
      "end": 37.254,
      "duration": 1.536
    },
    {
      "text": "Телефоны звонят, но данных нет.",
      "start": 37.554,
      "end": 40.65,
      "duration": 3.096
    },
    {
      "text": "СМС работают, но медленно.",
      "start": 40.95,
      "end": 43.878,
      "duration": 2.928
    },
    {
      "text": "Люди не могут перевести деньги.",
      "start": 44.178,
      "end": 46.938,
      "duration": 2.76
    },
    {
      "text": "Банкоматы не выдают наличные.",
      "start": 47.238,
      "end": 49.926,
      "duration": 2.688
    },
    {
      "text": "Магазины не принимают карты.",
      "start": 50.226,
      "end": 52.722,
      "duration": 2.496
    },
    {
      "text": "Кассовые аппараты зависли.",
      "start": 53.022,
      "end": 55.374,
      "duration": 2.352
    },
    {
      "text": "Очереди в магазинах.",
      "start": 55.674,
      "end": 57.618,
      "duration": 1.944
    },
    {
      "text": "Люди снимают наличные.",
      "start": 57.918,
      "end": 60.15,
      "duration": 2.232
    },
    {
      "text": "Но банки не работают.",
      "start": 60.45,
      "end": 62.466,
      "duration": 2.016
    },
    {
      "text": "Наличные кончаются.",
      "start": 62.766,
      "end": 64.806,
      "duration": 2.04
    },
    {
      "text": "День второй.",
      "start": 65.106,
      "end": 66.354,
      "duration": 1.248
    },
    {
      "text": "Новости только по радио и ТВ.",
      "start": 66.654,
      "end": 69.534,
      "duration": 2.88
    },
    {
      "text": "Но телеканалы тоже зависят от интернета.",
      "start": 69.834,
      "end": 73.338,
      "duration": 3.504
    },
    {
      "text": "Спутниковая связь работает.",
      "start": 73.638,
      "end": 76.086,
      "duration": 2.448
    },
    {
      "text": "Но её мало.",
      "start": 76.386,
      "end": 77.73,
      "duration": 1.344
    },
    {
      "text": "Люди выходят на улицу.",
      "start": 78.03,
      "end": 80.214,
      "duration": 2.184
    },
    {
      "text": "Общаются лично.",
      "start": 80.514,
      "end": 82.17,
      "duration": 1.656
    },
    {
      "text": "Соседи знакомятся.",
      "start": 82.47,
      "end": 84.294,
      "duration": 1.824
    },
    {
      "text": "Семьи проводят время вместе.",
      "start": 84.594,
      "end": 87.138,
      "duration": 2.544
    },
    {
      "text": "Дети играют на улице.",
      "start": 87.438,
      "end": 89.574,
      "duration": 2.136
    },
    {
      "text": "Без телефонов.",
      "start": 89.874,
      "end": 91.362,
      "duration": 1.488
    },
    {
      "text": "Без планшетов.",
      "start": 91.662,
      "end": 93.15,
      "duration": 1.488
    },
    {
      "text": "Без мультиков на Ютубе.",
      "start": 93.45,
      "end": 95.514,
      "duration": 2.064
    },
    {
      "text": "День третий.",
      "start": 95.814,
      "end": 97.11,
      "duration": 1.296
    },
    {
      "text": "Компании теряют миллиарды.",
      "start": 97.41,
      "end": 99.978,
      "duration": 2.568
    },
    {
      "text": "Биржи закрыты.",
      "start": 100.278,
      "end": 101.838,
      "duration": 1.56
    },
    {
      "text": "Акции не торгуются.",
      "start": 102.138,
      "end": 104.106,
      "duration": 1.968
    },
    {
      "text": "Логистика сломана.",
      "start": 104.406,
      "end": 106.254,
      "duration": 1.848
    },
    {
      "text": "Грузовики не знают куда ехать.",
      "start": 106.554,
      "end": 109.386,
      "duration": 2.832
    },
    {
      "text": "Склады пустеют.",
      "start": 109.686,
      "end": 111.318,
      "duration": 1.632
    },
    {
      "text": "Еда начинает кончаться.",
      "start": 111.618,
      "end": 113.826,
      "duration": 2.208
    },
    {
      "text": "Цены растут.",
      "start": 114.126,
      "end": 115.542,
      "duration": 1.416
    },
    {
      "text": "Инфляция.",
      "start": 115.842,
      "end": 117.162,
      "duration": 1.32
    },
    {
      "text": "День четвёртый.",
      "start": 117.462,
      "end": 118.974,
      "duration": 1.512
    },
    {
      "text": "Государства вводят чрезвычайное положение.",
      "start": 119.274,
      "end": 122.85,
      "duration": 3.576
    },
    {
      "text": "Военные связываются по рации.",
      "start": 123.15,
      "end": 126.03,
      "duration": 2.88
    },
    {
      "text": "Почта работает.",
      "start": 126.33,
      "end": 127.938,
      "duration": 1.608
    },
    {
      "text": "Но медленно.",
      "start": 128.238,
      "end": 129.51,
      "duration": 1.272
    },
    {
      "text": "Письма идут неделями.",
      "start": 129.81,
      "end": 131.778,
      "duration": 1.968
    },
    {
      "text": "Люди пишут письма.",
      "start": 132.078,
      "end": 133.854,
      "duration": 1.776
    },
    {
      "text": "Бумажные письма.",
      "start": 134.154,
      "end": 135.81,
      "duration": 1.656
    },
    {
      "text": "Как в старые времена.",
      "start": 136.11,
      "end": 137.958,
      "duration": 1.848
    },
    {
      "text": "День пятый.",
      "start": 138.258,
      "end": 139.506,
      "duration": 1.248
    },
    {
      "text": "Появляются новые профессии.",
      "start": 139.806,
      "end": 142.398,
      "duration": 2.592
    },
    {
      "text": "Курьеры, связисты, почтальоны.",
      "start": 142.698,
      "end": 146.082,
      "duration": 3.384
    },
    {
      "text": "Люди учатся чинить вещи.",
      "start": 146.382,
      "end": 148.734,
      "duration": 2.352
    },
    {
      "text": "Ремонт вместо покупки.",
      "start": 149.034,
      "end": 151.122,
      "duration": 2.088
    },
    {
      "text": "Чинить старые телефоны.",
      "start": 151.422,
      "end": 153.63,
      "duration": 2.208
    },
    {
      "text": "Использовать старые компьютеры.",
      "start": 153.93,
      "end": 156.474,
      "duration": 2.544
    },
    {
      "text": "Без обновлений.",
      "start": 156.774,
      "end": 158.238,
      "duration": 1.464
    },
    {
      "text": "Без новых приложений.",
      "start": 158.538,
      "end": 160.434,
      "duration": 1.896
    },
    {
      "text": "День седьмой.",
      "start": 160.734,
      "end": 162.03,
      "duration": 1.296
    },
    {
      "text": "Неделя без интернета.",
      "start": 162.33,
      "end": 164.25,
      "duration": 1.92
    },
    {
      "text": "Мир изменился.",
      "start": 164.55,
      "end": 166.11,
      "duration": 1.56
    },
    {
      "text": "Люди стали ближе.",
      "start": 166.41,
      "end": 168.09,
      "duration": 1.68
    },
    {
      "text": "Общаются больше.",
      "start": 168.39,
      "end": 170.094,
      "duration": 1.704
    },
    {
      "text": "Читают книги.",
      "start": 170.394,
      "end": 171.93,
      "duration": 1.536
    },
    {
      "text": "Играют в настольные игры.",
      "start": 172.23,
      "end": 174.414,
      "duration": 2.184
    },
    {
      "text": "Гуляют на улице.",
      "start": 174.714,
      "end": 176.514,
      "duration": 1.8
    },
    {
      "text": "Здоровье улучшилось.",
      "start": 176.814,
      "end": 178.71,
      "duration": 1.896
    },
    {
      "text": "Стресс уменьшился.",
      "start": 179.01,
      "end": 180.786,
      "duration": 1.776
    },
    {
      "text": "Но экономика в кризисе.",
      "start": 181.086,
      "end": 183.27,
      "duration": 2.184
    },
    {
      "text": "Безработица растёт.",
      "start": 183.57,
      "end": 185.514,
      "duration": 1.944
    },
    {
      "text": "Многие потеряли работу.",
      "start": 185.814,
      "end": 187.974,
      "duration": 2.16
    },
    {
      "text": "Но появились новые.",
      "start": 188.274,
      "end": 190.17,
      "duration": 1.896
    },
    {
      "text": "Новые возможности.",
      "start": 190.47,
      "end": 192.342,
      "duration": 1.872
    },
    {
      "text": "Новая жизнь.",
      "start": 192.642,
      "end": 194.01,
      "duration": 1.368
    },
    {
      "text": "Интернет изменил мир.",
      "start": 194.31,
      "end": 196.23,
      "duration": 1.92
    },
    {
      "text": "Но мир без интернета тоже возможен.",
      "start": 196.53,
      "end": 199.722,
      "duration": 3.192
    },
    {
      "text": "Может быть, мы слишком зависимы?",
      "start": 200.022,
      "end": 203.046,
      "duration": 3.024
    },
    {
      "text": "Что думаешь ты?",
      "start": 203.346,
      "end": 204.834,
      "duration": 1.488
    },
    {
      "text": "Напиши в комментариях.",
      "start": 205.134,
      "end": 207.078,
      "duration": 1.944
    },
    {
      "text": "Подпишись на канал.",
      "start": 207.378,
      "end": 209.034,
      "duration": 1.656
    },
    {
      "text": "И поделись этим видео.",
      "start": 209.334,
      "end": 211.374,
      "duration": 2.04
    }
  ]
}