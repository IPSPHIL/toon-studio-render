{"voice": "own", "total": 14.42, "lines": [{"i": 0, "text": "In a city of millions, one hero rises.", "start": 0.0, "end": 3.62, "words": [{"w": "In", "t": 0.0}, {"w": "a", "t": 0.46}, {"w": "city", "t": 0.58}, {"w": "of", "t": 0.8}, {"w": "millions,", "t": 1.0}, {"w": "one", "t": 2.28}, {"w": "hero", "t": 2.64}, {"w": "rises.", "t": 3.02}]}, {"i": 1, "text": "His name\u2026 is Nova.", "start": 4.44, "end": 5.42, "words": [{"w": "His", "t": 4.44}, {"w": "name\u2026", "t": 4.58}, {"w": "is", "t": 4.88}, {"w": "Nova.", "t": 5.1}]}, {"i": 2, "text": "He can control light itself.", "start": 6.28, "end": 8.0, "words": [{"w": "He", "t": 6.28}, {"w": "can", "t": 6.44}, {"w": "control", "t": 6.64}, {"w": "light", "t": 7.14}, {"w": "itself.", "t": 7.46}]}, {"i": 3, "text": "Every photon bends to his will.", "start": 9.06, "end": 11.0, "words": [{"w": "Every", "t": 9.06}, {"w": "photon", "t": 9.36}, {"w": "bends", "t": 9.78}, {"w": "to", "t": 10.18}, {"w": "his", "t": 10.48}, {"w": "will.", "t": 10.64}]}, {"i": 4, "text": "But tonight, the city faces darkness.", "start": 11.66, "end": 14.42, "words": [{"w": "But", "t": 11.66}, {"w": "tonight,", "t": 11.8}, {"w": "the", "t": 12.94}, {"w": "city", "t": 13.08}, {"w": "faces", "t": 13.36}, {"w": "darkness.", "t": 13.92}]}]}